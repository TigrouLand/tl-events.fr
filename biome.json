{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "files": {
    "includes": ["**", "!**/.nuxt"]
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": { "groups": [{ "type": true }] }
        },
        "useSortedAttributes": "on",
        "useSortedProperties": "on"
      }
    }
  },

  "formatter": {
    "includes": ["**/*.vue", "**/*.ts"],
    "indentStyle": "space",
    "indentWidth": 2,
    "bracketSameLine": true,
    "lineEnding": "lf",
    "lineWidth": 140
  },

  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": true,
      "bracketSpacing": true,
      "quoteStyle": "single",
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },

  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "nursery": {
            "useSortedClasses": {
              "level": "info",
              "options": {
                "attributes": ["class"],
                "functions": ["clsx"]
              }
            }
          },
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
